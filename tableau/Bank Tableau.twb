            <run bold='true' fontcolor='#a0cbe8' fontname='Times New Roman' fontsize='12'>[Parameters].[Parameter 1]</run>
            <run bold='true' fontcolor='#a0cbe8' fontname='Times New Roman' fontsize='12'>&gt; by States</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Wrkin Bank Loan' name='federated.0sx3zk011rub1z1c7adm90zlbk3o' />
            <datasource name='Parameters' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Measure' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Total Received Amount&quot;'>
              <calculation class='tableau' formula='&quot;Total Received Amount&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0sx3zk011rub1z1c7adm90zlbk3o'>
            <column caption='Daynamic Measure' datatype='integer' name='[Calculation_1595963118421016585]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1]=&apos;Total Loan Applications&apos; THEN [Calculation_2268969852728344576]&#13;&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Total Funded Amount&apos; THEN [Calculation_2268969852753268745]&#13;&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Total Received Amount&apos; THEN [Calculation_2268969852753829898] END' />
            </column>
            <column caption='Total Loan Applications' datatype='integer' name='[Calculation_2268969852728344576]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Count([id])' />
            </column>
            <column caption='Total Funded Amount' datatype='integer' name='[Calculation_2268969852753268745]' role='measure' type='quantitative'>
